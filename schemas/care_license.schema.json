{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/care_license.schema.json",
  "title": "CareLicense",
  "type": "object",
  "additionalProperties": false,
  "required": ["license_id", "purpose", "obligations", "issued_by_role", "issued_at"],
  "properties": {
    "license_id": {
      "type": "string",
      "pattern": "^CL-[A-Z0-9-]+$",
      "description": "Identifier for the care license."
    },
    "purpose": {
      "type": "string",
      "minLength": 8,
      "description": "Why access is requested, in care terms."
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      },
      "description": "Commitments assumed by the accessing role."
    },
    "issued_by_role": {
      "type": "string",
      "minLength": 3,
      "description": "Role granting the license (not a personal identity)."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp for issuance."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration timestamp."
    }
  }
}
